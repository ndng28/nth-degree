---
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  pubDate?: string;
}

const {
  title,
  description = "Engineering, leadership, and the homelab",
  pubDate,
} = Astro.props;

function readingTime(text: string): string {
  const words = text.trim().split(/\s+/).length;
  const min = Math.max(1, Math.round(words / 200));
  return `${min} min read`;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b0e" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={"https://blog.ddght.net" + Astro.url.pathname} />
    <meta name="twitter:card" content="summary_large_data" />
    <title>{title} — nth degree</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="nth degree" href="/feed.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300..700&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
    <ClientRouter fallback="swap" />
    <style is:global>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html {
        scroll-behavior: smooth;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      body {
        background: var(--bg);
        color: var(--text-body);
        font-family: var(--font-body);
        font-size: var(--text-ml);
        line-height: var(--line-height-body);
        min-height: 100vh;
        position: relative;
      }
      a {
        color: var(--text-body);
        text-decoration: none;
        transition: color 0.15s;
      }
      a:hover { color: var(--accent); }
      ::selection { background: var(--selection); }
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
    <style>
      /* ── Fluid tokens ── */
      :root {
        --space-xs:    clamp(0.25rem, 0.2rem + 0.25vw, 0.5rem);
        --space-sm:    clamp(0.5rem, 0.4rem + 0.5vw, 0.75rem);
        --space-md:    clamp(0.75rem, 0.6rem + 0.75vw, 1rem);
        --space-lg:    clamp(1rem, 0.85rem + 0.75vw, 1.5rem);
        --space-xl:    clamp(1.5rem, 1.25rem + 1.25vw, 2.5rem);
        --space-2xl:   clamp(2rem, 1.5rem + 2.5vw, 4rem);

        --text-xs:     clamp(0.65rem, 0.6rem + 0.25vw, 0.75rem);
        --text-sm:     clamp(0.75rem, 0.7rem + 0.25vw, 0.875rem);
        --text-base:   clamp(0.95rem, 0.9rem + 0.25vw, 1.05rem);  /* ~15.2px → 16.8px */
        --text-ml:     clamp(1rem, 0.95rem + 0.25vw, 1.1rem);     /*  16px   → 17.6px  -- content body */
        --text-lg:     clamp(1.125rem, 1.05rem + 0.4vw, 1.35rem); /*  18px   → 21.6px  -- h3 / hero desc */
        --text-xl:     clamp(1.25rem, 1.1rem + 0.75vw, 1.65rem);  /*  20px   → 26.4px  -- h2 */
        --text-2xl:    clamp(1.5rem, 1.2rem + 1.5vw, 2.25rem);    /*  24px   → 36px    -- h1 page */
        --text-3xl:    clamp(1.75rem, 1.3rem + 2.25vw, 2.75rem);  /*  28px   → 44px    -- h1 hero */

        --line-height-tight: 1.2;
        --line-height-body: 1.75;
        --line-height-relaxed: 1.85;

        --radius-sm: 4px;
        --radius: 8px;
        --max-width: 1280px;
        --font-body: "Inter", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
      }

      /* ── Dark mode colours (Azure, easy on eyes) ── */
      :root {
        --bg:            #0b0e14;
        --bg-elevated:   #11161f;
        --bg-raised:     #181e2a;
        --bg-overlay:    #1e2532;
        --border-subtle: #252d3d;
        --border:        #30384a;
        --border-strong: #404a5e;
        --text-body:     #d6dce6;
        --text-secondary:#9aa4b8;
        --text-muted:    #6a748a;
        --text-inverse:  #0b0e14;
        --accent:        #4da6ff;
        --accent-hover:  #70b8ff;
        --accent-dim:    #1a7fe8;
        --accent-subtle: #142642;
        --code-bg:       #0d121c;
        --selection:     rgba(77, 166, 255, 0.25);
      }

      /* ── Light mode colours (Azure) ── */
      @media (prefers-color-scheme: light) {
        :root {
          --bg:            #f8f9fc;
          --bg-elevated:   #eef0f5;
          --bg-raised:     #e4e7ee;
          --bg-overlay:    rgba(0, 0, 0, 0.04);
          --border-subtle: #d4d8e2;
          --border:        #c0c6d4;
          --border-strong: #a0a8ba;
          --text-body:     #14171f;
          --text-secondary:#4a5266;
          --text-muted:    #6a748a;
          --text-inverse:  #ffffff;
          --accent:        #0070d2;
          --accent-hover:  #0060b8;
          --accent-dim:    #005aad;
          --accent-subtle: #e0ecfa;
          --code-bg:       #f0f2f6;
          --selection:     rgba(0, 112, 210, 0.18);
        }
      }

      /* ── Scrollbar ── */
      ::-webkit-scrollbar { width: 8px; height: 8px; }
      ::-webkit-scrollbar-track { background: transparent; }
      ::-webkit-scrollbar-thumb {
        background: var(--border);
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover { background: var(--border-strong); }

      body::before {
        content: '';
        position: fixed;
        inset: 0;
        background-image: radial-gradient(circle, var(--border-subtle) 0.5px, transparent 0.5px);
        background-size: 24px 24px;
        opacity: 0.25;
        pointer-events: none;
        z-index: -1;
      }
      @media (prefers-color-scheme: light) {
        body::before { opacity: 0.12; }
      }

      .page-wrap {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 6rem 3.5rem 4rem;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      @media (max-width: 1280px) {
        .page-wrap {
          padding: 5rem 3rem 3rem;
        }
      }

      @media (max-width: 1024px) {
        .page-wrap {
          padding: 5rem 3rem 3rem;
        }
      }

      @media (max-width: 768px) {
        .page-wrap {
          padding: 3.5rem 2rem 2rem;
        }
      }

      @media (max-width: 480px) {
        .page-wrap {
          padding: 3rem 1.5rem 1.5rem;
        }
      }

      /* ── Nav ── */
      nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: var(--space-2xl);
        padding-bottom: var(--space-lg);
        border-bottom: 1px solid var(--border);
      }

      .site-logo {
        font-size: var(--text-2xl);
        font-weight: 700;
        letter-spacing: -0.03em;
      }
      .site-logo a { color: var(--text-body); }
      .site-logo a:hover { opacity: 0.7; text-decoration: none; }
      .site-logo .logo-accent {
        background: linear-gradient(135deg, var(--accent), #a78bfa);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .nav-links {
        display: flex;
        gap: var(--space-xl);
        align-items: center;
      }
      .nav-links a {
        color: var(--text-muted);
        font-size: var(--text-sm);
        font-weight: 500;
        position: relative;
        transition: color 0.2s;
      }
      .nav-links a:hover {
        color: var(--text-body);
        text-decoration: none;
        opacity: 1;
      }
      .nav-links a::after {
        content: '';
        position: absolute;
        bottom: -0.35rem;
        left: 0;
        width: 0;
        height: 1.5px;
        background: var(--accent);
        transition: width 0.2s ease;
      }
      .nav-links a:hover::after { width: 100%; }

      /* ── Page headers ── */
      header.page-header { margin-bottom: var(--space-2xl); }
      header.page-header h1 {
        font-size: var(--text-2xl);
        font-weight: 650;
        letter-spacing: -0.03em;
        line-height: var(--line-height-tight);
      }
      header.page-header .subtitle {
        color: var(--text-secondary);
        font-size: var(--text-base);
        margin-top: var(--space-sm);
        line-height: 1.5;
      }

      /* ── Hero ── */
      header.hero {
        margin-bottom: var(--space-2xl);
        padding-bottom: var(--space-xl);
        border-bottom: 1px solid var(--border);
      }
      header.hero h1 {
        font-size: var(--text-3xl);
        font-weight: 700;
        letter-spacing: -0.04em;
        line-height: var(--line-height-tight);
        margin-bottom: var(--space-md);
      }
      header.hero .hero-tagline {
        font-size: var(--text-lg);
        color: var(--text-secondary);
        line-height: 1.6;
        max-width: 520px;
      }

      time { color: var(--text-muted); font-size: var(--text-sm); }

      /* ── Article content ── */
      .content {
        font-size: var(--text-ml);
        line-height: var(--line-height-relaxed);
      }
      .content h2 {
        font-size: var(--text-xl);
        font-weight: 600;
        margin: var(--space-2xl) 0 var(--space-md);
        letter-spacing: -0.02em;
        line-height: var(--line-height-tight);
      }
      .content h3 {
        font-size: var(--text-lg);
        font-weight: 600;
        margin: var(--space-xl) 0 var(--space-sm);
        letter-spacing: -0.01em;
      }
      .content p { margin-bottom: var(--space-lg); }
      .content ul, .content ol { margin: var(--space-md) 0 var(--space-lg) 1.5rem; }
      .content li { margin-bottom: var(--space-xs); }
      .content li > ul, .content li > ol { margin-top: var(--space-xs); margin-bottom: var(--space-xs); }

      .content blockquote {
        border-left: 3px solid var(--accent);
        padding-left: var(--space-lg);
        margin: var(--space-xl) 0;
        color: var(--text-secondary);
        font-style: italic;
      }
      .content hr {
        border: none;
        border-top: 1px solid var(--border-subtle);
        margin: var(--space-2xl) 0;
      }
      .content img {
        max-width: 100%;
        height: auto;
        border-radius: var(--radius);
        border: 1px solid var(--border);
        margin: var(--space-lg) 0;
        background: var(--bg-elevated);
      }
      .content figure { margin: var(--space-lg) 0; }
      .content figcaption {
        text-align: center;
        font-size: var(--text-xs);
        color: var(--text-muted);
        margin-top: var(--space-xs);
      }

      /* ── Inline code ── */
      .content :not(pre) > code {
        font-family: var(--font-mono);
        font-size: 0.825em;
        background: var(--bg-elevated);
        padding: 0.15em 0.45em;
        border-radius: var(--radius-sm);
        border: 1px solid var(--border-subtle);
        color: var(--accent);
        word-break: break-word;
      }

      /* ── Code blocks ── */
      .content pre {
        background: var(--code-bg);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: var(--space-lg) var(--space-xl);
        overflow-x: auto;
        margin: var(--space-xl) 0;
        -webkit-overflow-scrolling: touch;
        position: relative;
      }

      /* Code block language label */
      .content pre::before {
        content: attr(data-language);
        position: absolute;
        top: 0.5rem;
        right: 0.75rem;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        opacity: 0.4;
        pointer-events: none;
      }

      .content pre:hover::before {
        opacity: 0.7;
        transition: opacity 0.2s;
      }
      .content pre code {
        font-family: var(--font-mono);
        background: none;
        padding: 0;
        border: none;
        font-size: 0.875em;
        line-height: 1.6;
        color: var(--text-body);
        tab-size: 2;
      }
      .content pre::-webkit-scrollbar { height: 6px; }
      .content pre::-webkit-scrollbar-track { background: transparent; }
      .content pre::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

      /* ── Tables ── */
      .content table {
        width: 100%;
        border-collapse: collapse;
        margin: var(--space-lg) 0;
        font-size: var(--text-sm);
        overflow-x: auto;
        display: block;
      }
      .content th, .content td {
        padding: var(--space-sm) var(--space-md);
        border: 1px solid var(--border);
        text-align: left;
      }
      .content th {
        background: var(--bg-elevated);
        font-weight: 600;
      }
      .content tbody tr:hover { background: var(--bg-elevated); }

      /* ── Tags ── */
      .tags { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
      .tag {
        font-size: var(--text-xs);
        font-weight: 500;
        letter-spacing: 0.02em;
        color: var(--text-muted);
        background: var(--accent-subtle);
        border: 1px solid var(--border-subtle);
        padding: 0.2em 0.6em;
        border-radius: 999px;
        text-decoration: none;
        transition: color 0.15s, border-color 0.15s;
        text-transform: uppercase;
      }
      .tag:hover {
        color: var(--accent);
        border-color: var(--accent);
        text-decoration: none;
        opacity: 1;
      }
      .tag[data-active="true"] { color: var(--accent); border-color: var(--accent); }

      /* ── Post meta ── */
      .post-meta { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-sm); }
      .post-meta .meta-sep { color: var(--border-subtle); font-size: var(--text-xs); }

      /* ── Footer ── */
      footer.site-footer {
        margin-top: auto;
        padding-top: var(--space-xl);
        padding-bottom: var(--space-xs);
        border-top: 1px solid var(--border-subtle);
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: var(--space-md);
        font-size: var(--text-xs);
        color: var(--text-muted);
      }
      footer.site-footer .footer-links { display: flex; gap: var(--space-lg); }
      footer.site-footer .footer-links a { color: var(--text-muted); font-size: var(--text-xs); }
      footer.site-footer .footer-links a:hover { color: var(--text-body); text-decoration: none; }

      /* ── Utility ── */
      .back-link {
        display: inline-block;
        color: var(--text-muted);
        font-size: var(--text-sm);
        margin-bottom: var(--space-lg);
        transition: color 0.15s;
      }
      .back-link:hover { color: var(--accent); text-decoration: none; }
      .back-link::before { content: '\2190  '; }

      /* ── Reading progress bar ── */
      @supports (animation-timeline: scroll()) {
        .progress-bar {
          position: fixed;
          top: 0; left: 0;
          width: 100%;
          height: 3px;
          background: transparent;
          z-index: 100;
          transform-origin: left;
          animation: progress-grow linear;
          animation-timeline: scroll(root);
        }
        .progress-bar::after {
          content: '';
          display: block;
          height: 100%;
          background: var(--accent);
          transform-origin: left;
          animation: progress-grow linear;
          animation-timeline: scroll(root);
        }
        @keyframes progress-grow {
          from { transform: scaleX(0); }
          to   { transform: scaleX(1); }
        }
      }
    </style>
  </head>
  <body>
    <div class="page-wrap">
    <nav>
      <span class="site-logo">
        <a href="/">nth<span class="logo-accent">°</span></a>
      </span>
      <span class="nav-links">
        <a href="/blog">Posts</a>
        <a href="/blog/tags">Tags</a>
        <a href="/about">About</a>
      </span>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <span>&copy; {new Date().getFullYear()} nth degree</span>
      <span class="footer-links">
        <a href="/feed.xml" target="_blank">RSS</a>
      </span>
    </footer>
    </div>
  </body>
</html>