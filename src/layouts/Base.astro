---
interface Props {
  title: string;
  description?: string;
  pubDate?: string;
}

const {
  title,
  description = "Engineering depth from a homelab portfolio",
  pubDate,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      :root {
        --bg: #0f0f0f;
        --surface: #1a1a1a;
        --border: #2a2a2a;
        --text: #e8e8e8;
        --muted: #888;
        --accent: #6eb5ff;
        --link: #a8c6e8;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        background: var(--bg);
        color: var(--text);
        font-family: "Geist", "Soehne", ui-sans-serif, system-ui, sans-serif;
        line-height: 1.7;
        max-width: 680px;
        margin: 0 auto;
        padding: 3rem 2rem;
      }

      @media (max-width: 600px) {
        body {
          padding: 2rem 1rem;
        }
      }

      a {
        color: var(--link);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 3.5rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--border);
      }

      nav .site-name {
        font-size: 1rem;
        font-weight: 500;
        letter-spacing: -0.01em;
      }

      nav .site-name a {
        color: var(--text);
      }

      nav .site-name a:hover {
        text-decoration: none;
        opacity: 0.8;
      }

      nav .nav-links {
        display: flex;
        gap: 1.25rem;
      }

      nav .nav-links a {
        color: var(--muted);
        font-size: 0.875rem;
        letter-spacing: 0.01em;
      }

      nav .nav-links a:hover {
        color: var(--text);
        text-decoration: none;
      }

      nav .nav-links a.active {
        color: var(--text);
      }

      header {
        margin-bottom: 2.5rem;
      }

      header h1 {
        font-size: 1.4rem;
        font-weight: 500;
        letter-spacing: -0.025em;
      }

      header h1 a {
        color: var(--text);
      }

      header .subtitle {
        color: var(--muted);
        font-size: 0.9rem;
        margin-top: 0.4rem;
      }

      header.hero {
        padding-bottom: 2rem;
        border-bottom: 1px solid var(--border);
        margin-bottom: 3rem;
      }

      header.hero h1 {
        font-size: 1.75rem;
        letter-spacing: -0.03em;
      }

      time {
        color: var(--muted);
        font-size: 0.85rem;
      }

      article {
        max-width: 100%;
      }

      h2 {
        font-size: 1.1rem;
        font-weight: 500;
        margin: 2rem 0 1rem;
        letter-spacing: -0.01em;
      }

      h3 {
        font-size: 1rem;
        font-weight: 500;
        margin: 1.5rem 0 0.75rem;
      }

      p {
        margin-bottom: 1.25rem;
      }

      ul,
      ol {
        margin: 1rem 0 1rem 1.5rem;
      }

      li {
        margin-bottom: 0.4rem;
      }

      blockquote {
        border-left: 2px solid var(--accent);
        padding-left: 1rem;
        color: var(--muted);
        margin: 1.5rem 0;
      }

      code {
        font-family: "Soehne Mono", ui-monospace, monospace;
        font-size: 0.875em;
        background: var(--surface);
        padding: 0.15em 0.4em;
        border-radius: 3px;
      }

      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1rem;
      }

      .tag {
        font-size: 0.75rem;
        color: var(--muted);
        background: var(--surface);
        border: 1px solid var(--border);
        padding: 0.15em 0.6em;
        border-radius: 3px;
      }

      .post-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 2rem;
      }

      footer {
        margin-top: 4rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 0.8rem;
      }
    </style>
  </head>
  <body>
    <nav>
      <span class="site-name"><a href="/">nth degree</a></span>
      <span class="nav-links">
        <a href="/blog">Blog</a>
      </span>
    </nav>

    <slot />
  </body>
</html>