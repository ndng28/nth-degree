---
interface Props {
  title: string;
  description?: string;
  pubDate?: string;
}

const {
  title,
  description = "Engineering depth from a homelab portfolio",
  pubDate,
} = Astro.props;

// Format reading time from word count
function readingTime(text: string): string {
  const words = text.trim().split(/\s+/).length;
  const min = Math.max(1, Math.round(words / 200));
  return `${min} min read`;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0b" />
    <title>{title} — nth degree</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="nth degree" href="/feed.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300..700&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
    <style>
      :root {
        --bg: #0a0a0b;
        --surface: #141416;
        --surface-alt: #1a1a1e;
        --border: #27272a;
        --border-light: #2a2a2e;
        --text: #e4e4e7;
        --text-secondary: #a1a1aa;
        --muted: #71717a;
        --accent: #60a5fa;
        --accent-dim: #3b82f6;
        --link: #93c5fd;
        --code-bg: #18181b;
        --selection: rgba(96, 165, 250, 0.2);
        --radius: 8px;
        --radius-sm: 4px;
        --max-width: 740px;
        --font-body: "Inter", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
      }

      @media (prefers-color-scheme: light) {
        :root {
          --bg: #ffffff;
          --surface: #f4f4f5;
          --surface-alt: #eaeaea;
          --border: #d4d4d8;
          --border-light: #e4e4e7;
          --text: #18181b;
          --text-secondary: #52525b;
          --muted: #71717a;
          --accent: #2563eb;
          --accent-dim: #1d4ed8;
          --link: #1d4ed8;
          --code-bg: #f4f4f5;
          --selection: rgba(37, 99, 235, 0.15);
        }
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      ::selection {
        background: var(--selection);
      }

      html {
        scroll-behavior: smooth;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      body {
        background: var(--bg);
        color: var(--text);
        font-family: var(--font-body);
        font-size: 17px;
        line-height: 1.75;
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 3rem 2.5rem;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      @media (max-width: 640px) {
        body {
          padding: 1.5rem 1rem;
          font-size: 16px;
        }
      }

      /* Links */
      a {
        color: var(--link);
        text-decoration: none;
        transition: opacity 0.15s;
      }

      a:hover {
        opacity: 0.8;
        text-decoration: underline;
      }

      /* Navigation */
      nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 4rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid var(--border);
      }

      .site-logo {
        font-size: 1.05rem;
        font-weight: 600;
        letter-spacing: -0.02em;
      }

      .site-logo a {
        color: var(--text);
      }

      .site-logo a:hover {
        opacity: 0.7;
        text-decoration: none;
      }

      .site-logo .logo-accent {
        color: var(--accent);
      }

      .nav-links {
        display: flex;
        gap: 1.75rem;
        align-items: center;
      }

      .nav-links a {
        color: var(--muted);
        font-size: 0.875rem;
        font-weight: 450;
        position: relative;
        transition: color 0.2s;
      }

      .nav-links a:hover {
        color: var(--text);
        text-decoration: none;
        opacity: 1;
      }

      .nav-links a::after {
        content: '';
        position: absolute;
        bottom: -0.25rem;
        left: 0;
        width: 0;
        height: 1.5px;
        background: var(--accent);
        transition: width 0.2s ease;
      }

      .nav-links a:hover::after {
        width: 100%;
      }

      /* Headers */
      header.page-header {
        margin-bottom: 3rem;
      }

      header.page-header h1 {
        font-size: 2rem;
        font-weight: 650;
        letter-spacing: -0.03em;
        line-height: 1.2;
      }

      header.page-header .subtitle {
        color: var(--text-secondary);
        font-size: 1rem;
        margin-top: 0.5rem;
        line-height: 1.5;
      }

      /* Hero (home page) */
      header.hero {
        margin-bottom: 3.5rem;
        padding-bottom: 2.5rem;
        border-bottom: 1px solid var(--border);
      }

      header.hero h1 {
        font-size: 2.75rem;
        font-weight: 700;
        letter-spacing: -0.04em;
        line-height: 1.1;
        margin-bottom: 0.75rem;
      }

      header.hero .hero-tagline {
        font-size: 1.1rem;
        color: var(--text-secondary);
        line-height: 1.6;
        max-width: 520px;
      }

      @media (max-width: 640px) {
        header.hero h1 {
          font-size: 2rem;
        }
        header.page-header h1 {
          font-size: 1.5rem;
        }
      }

      time {
        color: var(--muted);
        font-size: 0.85rem;
      }

      /* Typography for article content */
      .content {
        font-size: 17px;
        line-height: 1.8;
      }

      .content h2 {
        font-size: 1.35rem;
        font-weight: 600;
        margin: 2.5rem 0 0.75rem;
        letter-spacing: -0.02em;
        line-height: 1.3;
      }

      .content h3 {
        font-size: 1.1rem;
        font-weight: 600;
        margin: 2rem 0 0.5rem;
        letter-spacing: -0.01em;
      }

      .content p {
        margin-bottom: 1.35rem;
      }

      .content ul,
      .content ol {
        margin: 1rem 0 1.5rem 1.5rem;
      }

      .content li {
        margin-bottom: 0.35rem;
      }

      .content li > ul,
      .content li > ol {
        margin-top: 0.25rem;
        margin-bottom: 0.25rem;
      }

      .content blockquote {
        border-left: 3px solid var(--accent);
        padding-left: 1.25rem;
        margin: 1.75rem 0;
        color: var(--text-secondary);
        font-style: italic;
      }

      .content hr {
        border: none;
        border-top: 1px solid var(--border);
        margin: 2.5rem 0;
      }

      .content img {
        max-width: 100%;
        height: auto;
        border-radius: var(--radius);
        border: 1px solid var(--border);
        margin: 1.5rem 0;
      }

      .content figure {
        margin: 1.5rem 0;
      }

      .content figcaption {
        text-align: center;
        font-size: 0.8rem;
        color: var(--muted);
        margin-top: 0.5rem;
      }

      /* Inline code */
      .content :not(pre) > code {
        font-family: var(--font-mono);
        font-size: 0.85em;
        background: var(--surface);
        padding: 0.15em 0.45em;
        border-radius: var(--radius-sm);
        border: 1px solid var(--border-light);
        color: var(--accent);
        word-break: break-word;
      }

      /* Code blocks */
      .content pre {
        background: var(--code-bg);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.25rem 1.5rem;
        overflow-x: auto;
        margin: 1.75rem 0;
        -webkit-overflow-scrolling: touch;
      }

      .content pre code {
        font-family: var(--font-mono);
        background: none;
        padding: 0;
        border: none;
        font-size: 0.825em;
        line-height: 1.65;
        color: var(--text);
        tab-size: 2;
      }

      .content pre::-webkit-scrollbar {
        height: 6px;
      }

      .content pre::-webkit-scrollbar-track {
        background: transparent;
      }

      .content pre::-webkit-scrollbar-thumb {
        background: var(--border);
        border-radius: 3px;
      }

      /* Tables */
      .content table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5rem 0;
        font-size: 0.9rem;
      }

      .content th,
      .content td {
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--border);
        text-align: left;
      }

      .content th {
        background: var(--surface);
        font-weight: 600;
      }

      .content tbody tr:hover {
        background: var(--surface);
      }

      /* Tags */
      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
      }

      .tag {
        font-size: 0.7rem;
        font-weight: 500;
        letter-spacing: 0.02em;
        color: var(--muted);
        background: var(--surface);
        border: 1px solid var(--border);
        padding: 0.2em 0.6em;
        border-radius: 999px;
        text-decoration: none;
        transition: color 0.15s, border-color 0.15s;
        text-transform: uppercase;
      }

      .tag:hover {
        color: var(--accent);
        border-color: var(--accent);
        text-decoration: none;
        opacity: 1;
      }

      .tag[data-active="true"] {
        color: var(--accent);
        border-color: var(--accent);
      }

      /* Post meta (date, tags row) */
      .post-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      .post-meta .meta-sep {
        color: var(--border);
        font-size: 0.75rem;
      }

      /* Footer */
      footer.site-footer {
        margin-top: auto;
        padding-top: 2rem;
        padding-bottom: 0.5rem;
        border-top: 1px solid var(--border);
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        font-size: 0.8rem;
        color: var(--muted);
      }

      footer.site-footer .footer-links {
        display: flex;
        gap: 1.25rem;
      }

      footer.site-footer .footer-links a {
        color: var(--muted);
        font-size: 0.8rem;
      }

      footer.site-footer .footer-links a:hover {
        color: var(--text);
        text-decoration: none;
      }

      @media (max-width: 480px) {
        footer.site-footer {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.75rem;
        }
      }

      /* Utility */
      .back-link {
        display: inline-block;
        color: var(--muted);
        font-size: 0.875rem;
        margin-bottom: 1.5rem;
        transition: color 0.15s;
      }

      .back-link:hover {
        color: var(--accent);
        text-decoration: none;
      }

      .back-link::before {
        content: '\2190  ';
      }

      @media (max-width: 640px) {
        .content {
          font-size: 16px;
        }
        .content pre {
          padding: 1rem;
        }
      }
    </style>
  </head>
  <body>
    <nav>
      <span class="site-logo">
        <a href="/">nth<span class="logo-accent">°</span></a>
      </span>
      <span class="nav-links">
        <a href="/blog">Posts</a>
        <a href="/blog/tags">Tags</a>
        <a href="/about">About</a>
      </span>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <span>&copy; {new Date().getFullYear()} nth degree</span>
      <span class="footer-links">
        <a href="/feed.xml" target="_blank">RSS</a>
      </span>
    </footer>
  </body>
</html>