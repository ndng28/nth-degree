---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const allPosts = await getCollection("blog");
const posts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Base title="Posts" description="All posts — engineering, leadership, technology">
  <header class="page-header">
    <h1>Posts</h1>
    <p class="subtitle">{posts.length} post{posts.length !== 1 ? "s" : ""}</p>
  </header>

  <section>
    {posts.length === 0 ? (
      <p style="color: var(--text-muted)">No posts yet — check back soon.</p>
    ) : (
      <div class="post-list">
        {posts.map((post) => {
          const date = post.data.publishDate.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          });
          return (
            <a href={`/blog/${post.id}`} class="post-card">
              <div class="post-meta">
                <time datetime={post.data.publishDate.toISOString()}>{date}</time>
                {post.data.tags.length > 0 && (
                  <>
                    <span class="meta-sep">·</span>
                    <div class="tags">
                      {post.data.tags.map((tag) => (
                        <span class="tag">{tag}</span>
                      ))}
                    </div>
                  </>
                )}
              </div>
              <span class="post-title">{post.data.title}</span>
              <p class="post-desc">{post.data.description}</p>
            </a>
          );
        })}
      </div>
    )}
  </section>
</Base>

<style>
  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .post-card {
    display: block;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.75rem 2rem;
    text-decoration: none;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .post-card:hover {
    border-color: var(--accent);
    box-shadow: 0 4px 20px rgba(96, 165, 250, 0.06);
    transform: translateY(-1px);
    text-decoration: none;
    opacity: 1;
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .meta-sep {
    color: var(--border);
    font-size: 0.75rem;
  }

  .post-title {
    display: block;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-body);
    margin-bottom: 0.35rem;
    transition: color 0.15s;
  }

  .post-card:hover .post-title {
    color: var(--accent);
  }

  .post-desc {
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0;
  }
</style>
