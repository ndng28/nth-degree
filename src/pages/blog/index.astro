---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const allPosts = await getCollection("blog");
const posts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Base title="Blog" description="All posts — engineering, leadership, technology">
  <header style="margin-bottom: 2.5rem;">
    <h1>Blog</h1>
  </header>

  <section>
    {posts.length === 0 ? (
      <p style="color: var(--muted)">No posts yet — check back soon.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => {
          const date = post.data.publishDate.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          });
          return (
            <li>
              <a href={`/blog/${post.id}`} class="post-link">
                <span class="post-title">{post.data.title}</span>
              </a>
              <div class="post-meta">
                <time datetime={post.data.publishDate.toISOString()}>{date}</time>
                {post.data.tags.length > 0 && (
                  <div class="tags">
                    {post.data.tags.map((tag) => (
                      <a href={`/blog/tags/${tag}`} class="tag">{tag}</a>
                    ))}
                  </div>
                )}
              </div>
              <p class="post-desc">{post.data.description}</p>
            </li>
          );
        })}
      </ul>
    )}
  </section>
</Base>

<style>
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-list li {
    margin-bottom: 3.5rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    padding: 1.5rem;
    transition: border-color 0.2s;
  }

  .post-list li:last-child {
    margin-bottom: 0;
  }

  .post-list li:hover {
    border-color: var(--accent);
  }

  .post-link {
    display: block;
    text-decoration: none;
  }

  .post-link:hover {
    text-decoration: none;
    opacity: 0.8;
  }

  .post-title {
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.35rem;
    margin-bottom: 0.5rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tag {
    font-size: 0.7rem;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.1em 0.5em;
    border-radius: 3px;
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s;
  }

  .tag:hover {
    color: var(--text);
    border-color: var(--accent);
    text-decoration: none;
  }

  .post-desc {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }
</style>