---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog", ({ data }) => !data.draft);

  const tagSet = new Set<string>();
  for (const post of allPosts) {
    for (const tag of post.data.tags) tagSet.add(tag);
  }

  return Array.from(tagSet).map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: allPosts
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<Base title={`#${tag}`} description={`Posts tagged ${tag}`}>
  <header class="page-header">
    <h1>#<span class="tag-header-name">{tag}</span></h1>
    <p class="subtitle">
      {posts.length} post{posts.length !== 1 ? "s" : ""}
    </p>
  </header>

  {posts.length === 0 ? (
    <p style="color: var(--muted)">No posts with this tag yet.</p>
  ) : (
    <div class="post-list">
      {posts.map((post) => {
        const date = post.data.publishDate.toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
        });
        return (
          <a href={`/blog/${post.id}`} class="post-card">
            <div class="post-meta">
              <time datetime={post.data.publishDate.toISOString()}>{date}</time>
            </div>
            <span class="post-title">{post.data.title}</span>
            <p class="post-desc">{post.data.description}</p>
          </a>
        );
      })}
    </div>
  )}

  <div class="back-row">
    <a href="/blog/tags" class="back-link">All tags</a>
  </div>
</Base>

<style>
  .tag-header-name {
    color: var(--accent);
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .post-card {
    display: block;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.75rem 2rem;
    text-decoration: none;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .post-card:hover {
    border-color: var(--accent);
    box-shadow: 0 4px 20px rgba(96, 165, 250, 0.06);
    transform: translateY(-1px);
    text-decoration: none;
    opacity: 1;
  }

  .post-meta {
    margin-bottom: 0.5rem;
  }

  .post-title {
    display: block;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
    margin-bottom: 0.35rem;
    transition: color 0.15s;
  }

  .post-card:hover .post-title {
    color: var(--accent);
  }

  .post-desc {
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0;
  }

  .back-row {
    margin-top: 1rem;
  }
</style>
