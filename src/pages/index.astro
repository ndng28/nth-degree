---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const allPosts = await getCollection("blog");
const posts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 5);

const recent = posts[0];
---

<Base
  title="nth degree"
  description="Engineering depth from a homelab portfolio"
>
  <header class="hero">
    <h1>nth degree</h1>
    <p class="subtitle">Engineering depth from a homelab portfolio</p>
  </header>

  <section style="margin-top: 2.5rem;">
    {recent ? (
      <div>
        <p style="color: var(--muted); font-size: 0.8rem; margin-bottom: 0.5rem;">Latest</p>
        <a href={`/blog/${recent.id}`} style="font-size: 1.1rem; font-weight: 500;">
          {recent.data.title}
        </a>
        <p style="color: var(--muted); font-size: 0.875rem; margin-top: 0.25rem;">
          {recent.data.publishDate.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </p>
      </div>
    ) : (
      <p style="color: var(--muted)">No posts yet.</p>
    )}
  </section>

  {posts.length > 1 && (
    <section style="margin-top: 2.5rem;">
      <p style="color: var(--muted); font-size: 0.8rem; margin-bottom: 1rem;">More posts</p>
      <ul style="list-style: none; padding: 0; margin: 0;">
        {posts.slice(1).map((post) => (
          <li style="margin-bottom: 1rem;">
            <a href={`/blog/${post.id}`} style="font-weight: 500;">
              {post.data.title}
            </a>
            <span style="color: var(--muted); font-size: 0.8rem; margin-left: 0.75rem;">
              {post.data.publishDate.toLocaleDateString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section style="margin-top: 2.5rem;">
    <a href="/blog">View all posts</a>
  </section>
</Base>