---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const allPosts = await getCollection("blog");
const posts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 5);

const recent = posts[0];
---

<Base
  title="nth degree"
  description="Engineering depth from a homelab portfolio"
>
  <header class="hero">
    <h1>nth degree</h1>
    <p class="subtitle">Engineering depth from a homelab portfolio</p>
  </header>

  <section style="margin-top: 3rem;">
    <p style="color: var(--muted); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.5rem;">Latest</p>
    <a href={`/blog/${recent.id}`} style="font-size: 1.15rem; font-weight: 500; display: block; margin-bottom: 0.35rem;">
      {recent.data.title}
    </a>
    <p style="color: var(--muted); font-size: 0.8rem;">
      {recent.data.publishDate.toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
      })}
    </p>
  </section>

  {posts.length > 1 && (
    <section style="margin-top: 3rem;">
      <p style="color: var(--muted); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 1.25rem;">More posts</p>
      <ul style="list-style: none; padding: 0; margin: 0;">
        {posts.slice(1).map((post) => (
          <li style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;">
            <a href={`/blog/${post.id}`} style="font-weight: 500; flex: 1;">
              {post.data.title}
            </a>
            <span style="color: var(--muted); font-size: 0.8rem; white-space: nowrap;">
              {post.data.publishDate.toLocaleDateString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section style="margin-top: 3rem; padding-bottom: 2rem;">
    <a href="/blog" style="font-size: 0.875rem;">View all posts</a>
  </section>
</Base>