---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const allPosts = await getCollection("blog");
const posts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 5);

const recent = posts[0];
---

<Base title="Home" description="Engineering, leadership, and the homelab">
  <header class="hero">
    <h1>nth degree</h1>
    <p class="hero-tagline">
      Engineering. Leadership. Home Lab.
    </p>
  </header>

  {recent && (
    <section class="featured">
      <div class="featured-label">Latest</div>
      <div class="featured-card">
        <div class="featured-meta">
          <time datetime={recent.data.publishDate.toISOString()}>
            {recent.data.publishDate.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </time>
          {recent.data.tags.length > 0 && (
            <>
              <span class="meta-sep">·</span>
              <div class="tags">
                {recent.data.tags.map((tag) => (
                  <a href={`/blog/tags/${tag}`} class="tag">{tag}</a>
                ))}
              </div>
            </>
          )}
        </div>
        <a href={`/blog/${recent.id}`} class="featured-title">
          {recent.data.title}
        </a>
        <p class="featured-desc">{recent.data.description}</p>
      </div>
    </section>
  )}

  {posts.length > 1 && (
    <section class="more-posts">
      <h2>More posts</h2>
      <ul class="post-list">
        {posts.slice(1).map((post) => (
          <li>
            <a href={`/blog/${post.id}`} class="post-row">
              <span class="post-row-title">{post.data.title}</span>
              <time
                datetime={post.data.publishDate.toISOString()}
                class="post-row-date"
              >
                {post.data.publishDate.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })}
              </time>
            </a>
          </li>
        ))}
      </ul>
      <a href="/blog" class="all-link">View all posts →</a>
    </section>
  )}
</Base>

<style>
  header.hero {
    text-align: center;
    margin-bottom: 3.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
  }

  header.hero h1 {
    font-size: 2.75rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }

  header.hero .hero-tagline {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 520px;
    margin: 0 auto;
  }

  @media (max-width: 640px) {
    header.hero h1 {
      font-size: 2rem;
    }
    header.hero .hero-tagline {
      font-size: 0.95rem;
    }
  }

  .featured {
    margin-bottom: 3.5rem;
  }

  .featured-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .featured-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem;
    transition: border-color 0.2s, box-shadow 0.2s;
    text-align: left;
  }

  .featured-card:hover {
    border-color: var(--accent);
    box-shadow: 0 4px 24px rgba(96, 165, 250, 0.06);
  }

  .featured-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .meta-sep {
    color: var(--border);
    font-size: 0.75rem;
  }

  .featured-title {
    display: block;
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-body);
    margin-bottom: 0.5rem;
    line-height: 1.3;
    transition: color 0.15s;
  }

  .featured-title:hover {
    color: var(--accent);
    text-decoration: none;
    opacity: 1;
  }

  .featured-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .more-posts {
    text-align: center;
  }
  .more-posts {
  }
  .more-posts h2 {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
    text-align: left;
  }

  .post-list li {
    margin-bottom: 0.25rem;
  }

  .post-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    transition: color 0.15s;
  }

  .post-row:hover {
    text-decoration: none;
    opacity: 1;
  }

  .post-row:hover .post-row-title {
    color: var(--accent);
  }

  .post-row-title {
    font-size: 0.9rem;
    font-weight: 450;
    color: var(--text-body);
    flex: 1;
    transition: color 0.15s;
  }

  .post-row-date {
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .all-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--accent);
    font-weight: 500;
    margin-top: 0.25rem;
  }

  .all-link:hover {
    text-decoration: underline;
  }
</style>
